<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>l4_sterowanie</name>
  <version>1.0.0</version>
  <description>L4 Systemy mechatroniczne: trzy sposoby sterowania robotem UR5e w Gazebo (ros2_control, MoveIt)</description>
  <maintainer email="prowadzacy@pwr.edu.pl">Prowadzący kurs</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>ur_simulation_gz</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
